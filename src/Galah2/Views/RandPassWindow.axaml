<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.RandPassWindow"
        x:DataType="vm:RandPassViewModel"
        Title="RandPass"
        Width="580" Height="540"
        MinWidth="480" MinHeight="400"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent">
  <!-- The sixth sibling dialog: borderless surface + custom title bar, same grammar as the
       other five (see DialogChrome). Layout v2 (spec 2026-11-24-randpass §7): the generate
       button leads the left column, length/count are −/value/+ steppers, and a draggable
       hairline splits parameters (3*) from results (2*). The XAML carries no startup location:
       AppRuntime restores the remembered geometry or centres the window (PlacePanel's policy). -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="RandPass" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>

      <!-- 60/40 parameter/result split with a draggable hairline between the columns. -->
      <Grid Margin="16,14,16,14" ColumnDefinitions="3*,Auto,2*">
        <!-- ── parameters (left): button first, then the two steppers, then the checkboxes.
             The ScrollViewer is only a fallback for a shrunken window: at the default size the
             content fits, so no scrollbar may appear. ── -->
        <Border Grid.Column="0" MinWidth="240" Padding="0,0,10,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <Button Content="生成密码" Command="{Binding GenerateCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Padding="20,7" BorderThickness="0"
                      Background="{DynamicResource AccentSurfaceBrush}"
                      Foreground="{DynamicResource WindowBrush}" />
              <TextBlock Text="{Binding CopyStatus}" FontSize="11.5" HorizontalAlignment="Center"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding HasCopied}" />

              <!-- length stepper: label left, [− value ＋] right (spec §7) -->
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="密码长度" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="−" FontSize="13" Width="28" Height="28" Padding="0"
                        CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding DecLengthCommand}" />
                <TextBox Grid.Column="2" Width="46" Margin="6,0" FontSize="12.5"
                         VerticalAlignment="Center" HorizontalContentAlignment="Center"
                         Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Content="＋" FontSize="13" Width="28" Height="28" Padding="0"
                        CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding IncLengthCommand}" />
              </Grid>

              <!-- count stepper -->
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="密码数量" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="−" FontSize="13" Width="28" Height="28" Padding="0"
                        CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding DecCountCommand}" />
                <TextBox Grid.Column="2" Width="46" Margin="6,0" FontSize="12.5"
                         VerticalAlignment="Center" HorizontalContentAlignment="Center"
                         Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="3" Content="＋" FontSize="13" Width="28" Height="28" Padding="0"
                        CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding IncCountCommand}" />
              </Grid>

              <CheckBox IsChecked="{Binding Lower}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用小写字母" VerticalAlignment="Center" />
                  <TextBlock Text="abcdef…" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding Upper}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用大写字母" VerticalAlignment="Center" />
                  <TextBlock Text="ABCDEF…" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding Digits}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用数字" VerticalAlignment="Center" />
                  <TextBlock Text="1234567890" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding DoubleDigits}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="双位数字（25% 概率）" VerticalAlignment="Center" />
                  <TextBlock Text="11223344…" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding NoConfusables}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="无类似字符" VerticalAlignment="Center" />
                  <TextBlock Text="1, l, I, 3, L" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <StackPanel Spacing="5">
                <CheckBox IsChecked="{Binding CustomEnabled}" FontSize="12">
                  <TextBlock Text="使用自定义字符" />
                </CheckBox>
                <TextBox Text="{Binding CustomChars}" FontSize="12"
                         IsEnabled="{Binding CustomEnabled}" />
              </StackPanel>
              <StackPanel Spacing="5">
                <CheckBox IsChecked="{Binding UseFormat}" FontSize="12">
                  <TextBlock Text="使用自定义格式" />
                </CheckBox>
                <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Format}"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding UseFormat}" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- draggable hairline -->
        <GridSplitter Grid.Column="1" Width="8" Background="Transparent" Focusable="False"
                      ResizeDirection="Columns" />
        <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                Background="{DynamicResource HairlineBrush}" />

        <!-- ── results (right): one password per row; double-click a row to copy it ── -->
        <ListBox x:Name="ResultList" Grid.Column="2" MinWidth="150" Margin="8,0,0,0"
                 CornerRadius="8" Background="{DynamicResource ElevatedBrush}"
                 BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="4"
                 FontFamily="Consolas, monospace" FontSize="12.5"
                 ToolTip.Tip="双击任意一行即可复制到剪贴板"
                 DoubleTapped="ResultList_DoubleTapped"
                 ItemsSource="{Binding Results}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </Grid>
    </DockPanel>
  </Border>
</Window>
