<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.RandPassWindow"
        x:DataType="vm:RandPassViewModel"
        Title="RandPass"
        Width="580" Height="440"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">
  <!-- The sixth sibling dialog: borderless surface + custom title bar, same grammar as the
       other five (see DialogChrome). Left = parameters, right = results (spec 2026-11-24-randpass). -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource ElevatedBrush}"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="RandPass" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>

      <DockPanel Margin="16,12,16,14">
        <!-- ── parameters (left) ── -->
        <Border DockPanel.Dock="Left" Width="242" Margin="0,0,14,0"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0"
                Padding="0,0,14,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <StackPanel Width="88">
                  <TextBlock Text="密码长度" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  <NumericUpDown Value="{Binding Length}" Minimum="4" Maximum="64" FontSize="12" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="密码数量" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                  <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="100" FontSize="12" />
                </StackPanel>
              </StackPanel>

              <CheckBox IsChecked="{Binding Lower}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用小写字母" />
                  <TextBlock Text="abcdef…" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding Upper}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用大写字母" />
                  <TextBlock Text="ABCDEF…" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding Digits}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="使用数字" />
                  <TextBlock Text="1234567890" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding DoubleDigits}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="两位数字概率" />
                  <TextBlock Text="11223344…" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <CheckBox IsChecked="{Binding NoConfusables}" FontSize="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="无类似字符" />
                  <TextBlock Text="1, l, I, 3, L" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </CheckBox>
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding CustomEnabled}" FontSize="12">
                  <TextBlock Text="使用自定义字符" />
                </CheckBox>
                <TextBox Text="{Binding CustomChars}" FontSize="12"
                         IsEnabled="{Binding CustomEnabled}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <CheckBox IsChecked="{Binding UseFormat}" FontSize="12">
                  <TextBlock Text="使用自定义格式" />
                </CheckBox>
                <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Format}"
                          IsVisible="{Binding UseFormat}" FontSize="12" />
              </StackPanel>

              <Button Content="生成密码" Command="{Binding GenerateCommand}" Margin="0,6,0,0"
                      Background="{DynamicResource AccentSurfaceBrush}"
                      Foreground="{DynamicResource WindowBrush}" />
              <TextBlock Text="{Binding CopyStatus}" FontSize="11" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding HasCopied}" />
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- ── results (right): one password per row; double-click a row to copy it ── -->
        <ListBox x:Name="ResultList" FontFamily="Consolas, monospace" FontSize="12"
                 DoubleTapped="ResultList_DoubleTapped"
                 ItemsSource="{Binding Results}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
