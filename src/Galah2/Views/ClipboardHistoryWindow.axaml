<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.ClipboardHistoryWindow"
        x:DataType="vm:ClipboardHistoryViewModel"
        Title="剪贴板历史"
        Width="448" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="ListBox.clip-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TilePlaceholderBrush}" />
    </Style>
    <Style Selector="ListBox.clip-list ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>
  </Window.Styles>

  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- 自绘无边框标题栏 -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="剪贴板历史" />
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextFaintBrush}"
                     Text="{Binding CountLabel}" />
          <Button Grid.Column="2" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>

      <DockPanel Margin="14,12,14,10">
        <!-- 底部操作提示 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding FooterHint}"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />

        <!-- 搜索栏 + 筛选切换 + 清空 -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox" Grid.Column="0" Text="{Binding Filter, Mode=TwoWay}"
                   FontSize="12.5" Watermark="搜索剪贴板历史…" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="清空" Command="{Binding ClearCommand}"
                  ToolTip.Tip="清空所有未置顶的记录"
                  FontSize="11.5" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
          <Button Classes="chip" Classes.active="{Binding ShowAllActive}"
                  Content="全部" Command="{Binding ShowAllCommand}" FontSize="11.5" />
          <Button Classes="chip" Classes.active="{Binding PinnedOnly}"
                  Content="已置顶" Command="{Binding ShowPinnedCommand}" FontSize="11.5" />
        </StackPanel>

        <!-- 列表主体 -->
        <Panel>
          <TextBlock Text="{Binding EmptyText}" FontSize="12"
                     Foreground="{DynamicResource TextFaintBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsEmpty}" />

          <ListBox x:Name="HistoryList" Classes="clip-list"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   DoubleTapped="HistoryList_DoubleTapped"
                   IsVisible="{Binding !IsEmpty}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{Binding Preview}" FontSize="12.5"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextWrapping="Wrap" MaxLines="3"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,0,8,4" />
                  <TextBlock Grid.Row="1" Grid.Column="0"
                             Text="{Binding MetaText}" FontSize="10.5"
                             Foreground="{DynamicResource TextFaintBrush}" />

                  <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                              Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Button Classes="chip" Content="{Binding PinGlyph}"
                            Command="{Binding TogglePinCommand}"
                            ToolTip.Tip="{Binding PinTooltip}"
                            FontSize="13" Padding="6,2" />
                    <Button Classes="chip" Content="✕"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="删除"
                            FontSize="11" Padding="6,2" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
