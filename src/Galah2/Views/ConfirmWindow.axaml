<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Galah2.Views.ConfirmWindow"
        Width="380" Height="190"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}">
  <DockPanel Margin="18,14,18,14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,14,0,0">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="确定" Click="Ok_Click" Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
    </StackPanel>
    <TextBlock x:Name="Message" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top" />
  </DockPanel>
</Window>
