<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="720" Height="460"
        SystemDecorations="None"
        TransparencyLevelHint="Mica"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="False">
  <Border Background="#232327"
          CornerRadius="10"
          BorderBrush="#3A3A3F"
          BorderThickness="1">
    <DockPanel>
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="14,12,14,8">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TabViewModel">
            <Button Classes="chip" Content="{Binding Name}"
                    Classes.active="{Binding IsActive}"
                    Command="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).SelectTabCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Items}" Margin="10,0,10,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemViewModel">
              <Button Classes="tile"
                      Command="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).LaunchCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Name}">
                <StackPanel Width="76" Spacing="6">
                  <Panel Width="32" Height="32" HorizontalAlignment="Center">
                    <!-- The letter shows while the shell icon is being extracted, then hides. -->
                    <Border CornerRadius="6" Background="#2A2A2E"
                            IsVisible="{Binding !HasIcon}">
                      <TextBlock Text="{Binding Initial}" FontSize="14" Foreground="#F2F2F5"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="32" Height="32"
                           IsVisible="{Binding HasIcon}" />
                  </Panel>
                  <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                             Foreground="#C8C8CE"
                             TextTrimming="CharacterEllipsis" MaxLines="2" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
