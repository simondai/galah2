<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.PanelWindow"
        x:DataType="vm:PanelViewModel"
        Width="720" Height="460"
        SystemDecorations="None"
        TransparencyLevelHint="None"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="True"
        MinWidth="420" MinHeight="300">
  <!-- Semi-transparent so the Mica backdrop shows through. An opaque fill makes the material
       request pointless; the first screenshot check showed three different corner colours only
       because the DWM tint bled past the rounded corners. -->
  <Border x:Name="RootBorder"
          Background="{DynamicResource PanelFillBrush}" CornerRadius="10"
          BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>

      <!-- ===== custom chrome: drag area, menu, close ===== -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource ElevatedBrush}" CornerRadius="10,10,0,0" Height="34"
              PointerPressed="Chrome_PointerPressed">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <!-- The corner shows the product name, not the active category: the chip row already
               says which category is open, and a title that changes with it reads like a document
               name. 1.x drew "Galah · 启动器" here for the same reason. -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="12,0,0,0">
            <TextBlock Text="{Binding AppTitle}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextStrongBrush}" />
            <TextBlock Text="· 启动器" FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFaintBrush}" />
          </StackPanel>

          <!-- RandPass one-click entry (spec 2026-11-24-randpass): a vector keyhole - a Path,
               not a font glyph, so it renders identically on every machine and themes with the
               text brushes. Sits left of the ☰ menu; the menu keeps a RandPass row too. -->
          <Button Grid.Column="1" Classes="chip" Padding="6,0" VerticalAlignment="Center"
                  ToolTip.Tip="RandPass 密码生成"
                  Command="{Binding ShowRandPassCommand}">
            <Path Width="11" Height="13" Stretch="Uniform"
                  Fill="{DynamicResource TextMutedBrush}"
                  Data="M 5.5 0.6 A 3.2 3.2 0 1 1 5.49 0.6 Z M 4.1 4.9 L 6.9 4.9 L 8.6 12.4 L 2.4 12.4 Z" />
          </Button>
          <Button Grid.Column="2" Classes="chip" Content="☰" FontSize="15" Padding="8,0"
                  VerticalAlignment="Center">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="添加快捷方式…" Command="{Binding AddPickerCommand}" />
                <MenuItem Header="添加文件…" Command="{Binding AddFileCommand}" />
                <MenuItem Header="添加文件夹…" Command="{Binding AddFolderCommand}" />
                <MenuItem Header="添加网址…" Command="{Binding AddUrlCommand}" />
                <Separator />
                <MenuItem Header="新建分类" Command="{Binding NewTabCommand}" />
                <MenuItem Header="重命名分类" Command="{Binding RenameTabCommand}" />
                <MenuItem Header="删除分类" Command="{Binding DeleteTabCommand}" />
                <Separator />
                <MenuItem Header="维护与迁移…" Command="{Binding ShowMaintenanceCommand}" />
                <MenuItem Header="RandPass" Command="{Binding ShowRandPassCommand}" />
                <MenuItem Header="设置…" Command="{Binding ShowSettingsCommand}" />
                <Separator />
                <MenuItem Header="收起面板" Command="{Binding HideCommand}" />
                <MenuItem Header="退出程序" Command="{Binding ExitCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Grid.Column="3" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  VerticalAlignment="Center" Margin="2,0,6,0"
                  Command="{Binding HideCommand}" />
        </Grid>
      </Border>

      <!-- ===== save-failure banner (INV-9) ===== -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource DangerSurfaceBrush}" Padding="12,7"
              IsVisible="{Binding HasSaveProblem}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding SaveProblem}" FontSize="11.5"
                     Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="重试" Command="{Binding RetrySaveCommand}"
                  FontSize="11" Padding="10,3" Margin="10,0,0,0" />
        </Grid>
      </Border>

      <!-- ===== category strip: a top row, or a left rail =====
           Two instances rather than one control with a switched DockPanel.Dock: Dock is applied
           once at layout time, so flipping it on a live control would not re-dock reliably. -->
      <StackPanel Orientation="Horizontal" Margin="14,10,14,6"
                  DockPanel.Dock="Top" IsVisible="{Binding !IsVerticalTabs}">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <!-- A drop target: dragging a tile onto a category moves the item there.
                   FontSize follows the 分类名字号 setting (default 12 = the global Button size).
                   Right-click: rename + delete (delete only while the category is empty).
                   ContextMenu, not MenuFlyout: flyout items are not in the logical tree, so the
                   $parent command path dies and MenuItem greys the row out. A ContextMenu is the
                   logical child of its button, so $parent[Button] resolves on every open. -->
              <Button Classes="chip" Content="{Binding Name}" Tag="{Binding}"
                      FontSize="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).ChipFontSize}"
                      Classes.active="{Binding IsActive}"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="TabChip_DragOver" DragDrop.Drop="TabChip_Drop"
                      Command="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).SelectTabCommand}"
                      CommandParameter="{Binding}">
                <!-- Same menu as the horizontal strip (see its comment). -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="重命名分类" Command="{Binding RenameCommand}" />
                    <MenuItem Header="删除分类" Command="{Binding DeleteCommand}"
                              IsEnabled="{Binding HasNoEntries}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- New-category chip: the + that 1.x sat at the end of the tab row. -->
        <Button Classes="newtab" Command="{Binding NewTabCommand}"
                ToolTip.Tip="新建分类" AutomationProperties.Name="新建分类"
                Width="28" Height="28" MinWidth="0" Padding="0" Margin="4,1,0,2"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="chip" Background="#26D2D2D7" CornerRadius="14"
                      Width="28" Height="28">
                <TextBlock Text="＋" FontSize="15" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>

        <StackPanel Orientation="Vertical" Margin="10,10,8,10" Width="96"
                  DockPanel.Dock="Left" IsVisible="{Binding IsVerticalTabs}">
        <ItemsControl ItemsSource="{Binding Tabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Spacing raised 4 → 8 (2026-11-24): the vertical rail rows felt cramped. -->
              <StackPanel Orientation="Vertical" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TabViewModel">
              <!-- Same right-click menu as the horizontal strip (rename + delete-while-empty). -->
              <Button Classes="chip" Content="{Binding Name}" Tag="{Binding}"
                      FontSize="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).ChipFontSize}"
                      Classes.active="{Binding IsActive}"
                      HorizontalAlignment="Left"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="TabChip_DragOver" DragDrop.Drop="TabChip_Drop"
                      Command="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).SelectTabCommand}"
                      CommandParameter="{Binding}">
                <!-- The rows bind to the CHIP'S OWN TabViewModel (rename/delete commands wired by
                     the PanelViewModel in Refresh). A ContextMenu can only reach what it inherits
                     from its host control: $parent paths die at the popup boundary, and
                     XAML-attached Opening handlers never fire on a ContextMenu - both proven in
                     the 2026-11-24 grey-menu round, where this exact menu shipped grey while
                     every in-process probe passed (they never exercised the real open path). -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="重命名分类" Command="{Binding RenameCommand}" />
                    <MenuItem Header="删除分类" Command="{Binding DeleteCommand}"
                              IsEnabled="{Binding HasNoEntries}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- New-category chip: same + as the horizontal strip, hung below the left rail. -->
        <Button Classes="newtab" Command="{Binding NewTabCommand}"
                ToolTip.Tip="新建分类" AutomationProperties.Name="新建分类"
                Width="28" Height="28" MinWidth="0" Padding="0" Margin="11,6,0,4"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="chip" Background="#26D2D2D7" CornerRadius="14"
                      Width="28" Height="28">
                <TextBlock Text="＋" FontSize="15" FontWeight="Light"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>

      <!-- ===== toast: transient news, auto-dismisses ===== -->
      <Border DockPanel.Dock="Bottom" Margin="10,0,10,10" Padding="12,8" CornerRadius="8"
              Background="{DynamicResource HoverBrush}"
              IsVisible="{Binding Toast.IsOpen}">
        <TextBlock Text="{Binding Toast.Message}" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>

      <!-- ===== items ===== -->
      <!-- TileScroll is named: the wheel handler is attached in code so it can run after the
           presenter's own scroll handling (handledEventsToo), which is what makes "switch
           category only at the edge" work. -->
      <ScrollViewer x:Name="TileScroll" HorizontalScrollBarVisibility="Disabled">
        <!-- Entry point 1: right-click any empty space in the grid to add to the current
             category. A tile's own ContextMenu wins when the hit lands on one, so the two
             menus never double-open. Same four commands as the ☰ menu. -->
        <ScrollViewer.ContextMenu>
          <ContextMenu>
            <MenuItem Header="添加快捷方式…" Command="{Binding AddPickerCommand}" />
            <MenuItem Header="添加文件…" Command="{Binding AddFileCommand}" />
            <MenuItem Header="添加文件夹…" Command="{Binding AddFolderCommand}" />
            <MenuItem Header="添加网址…" Command="{Binding AddUrlCommand}" />
          </ContextMenu>
        </ScrollViewer.ContextMenu>
        <ItemsControl ItemsSource="{Binding Items}" Margin="10,0,10,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemViewModel">
              <Panel>
              <!-- Entry point 2: the placeholder tile that always ends the grid. Its click opens
                   the same add menu as the blank-space right-click; it never launches and never
                   starts a drag (both guarded in code), but it does accept a drop - landing on
                   it means "move to the end", which keeps the placeholder last by construction. -->
              <Button Classes="tile addtile" Tag="{Binding}" ToolTip.Tip="添加条目到当前分类"
                      IsVisible="{Binding IsAddTile}" Cursor="Hand"
                      Click="AddTile_Click"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Tile_DragOver" DragDrop.Drop="AddTile_Drop">
                <!-- A ContextMenu, not a MenuFlyout: flyout items are not in the logical tree.
                     The rows bind the SENTINEL'S OWN add commands (wired by the PanelViewModel),
                     so no $parent path and no DataContext swap is involved - the one pattern
                     proven live in the shipped app (the blank-space menu). A left click opens
                     this same menu from code (AddTile_Click). -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="添加快捷方式…" Command="{Binding AddPickerCommand}" />
                    <MenuItem Header="添加文件…" Command="{Binding AddFileCommand}" />
                    <MenuItem Header="添加文件夹…" Command="{Binding AddFolderCommand}" />
                    <MenuItem Header="添加网址…" Command="{Binding AddUrlCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Width="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).TileWidth}" Spacing="6">
                  <Panel Width="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                         Height="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                         HorizontalAlignment="Center">
                    <!-- A dashed outline reads as "placeholder, not content". Border cannot dash
                         in Avalonia (a WPF-only property), so the frame is a stroked Rectangle. -->
                    <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource TilePlaceholderBrush}"
                               Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1"
                               StrokeDashArray="3,3" />
                    <TextBlock Text="＋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                  </Panel>
                  <TextBlock Text="添加" FontSize="11" TextAlignment="Center"
                             Foreground="{DynamicResource TextFaintBrush}" />
                </StackPanel>
              </Button>
              <!-- Click and DoubleTapped both route to LaunchTile, which decides from the click mode
                   whether this gesture is an action. Binding Command would lose the click count. -->
              <Button Classes="tile" Tag="{Binding}" ToolTip.Tip="{Binding Name}"
                      IsVisible="{Binding !IsAddTile}"
                      Click="Tile_Click" DoubleTapped="Tile_DoubleTapped"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Tile_DragOver" DragDrop.Drop="Tile_Drop">
                <!-- The rows bind the TILE'S OWN ItemViewModel commands (wired by the
                     PanelViewModel in SelectTab). The old $parent[ItemsControl] paths could never
                     resolve across the popup boundary - this menu was grey in the real app the
                     whole time it existed, and no in-process probe could see it (2026-11-24). -->
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="打开" Command="{Binding OpenCommand}" />
                    <MenuItem Header="编辑…" Command="{Binding EditCommand}" />
                    <Separator />
                    <MenuItem Header="左移" Command="{Binding MoveLeftCommand}" />
                    <MenuItem Header="右移" Command="{Binding MoveRightCommand}" />
                    <Separator />
                    <MenuItem Header="删除" Command="{Binding DeleteCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Width="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).TileWidth}" Spacing="6">
                  <Panel Width="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                         Height="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                         HorizontalAlignment="Center">
                    <!-- The letter shows while the shell icon is extracted, then hides. -->
                    <Border CornerRadius="6" Background="{DynamicResource ElevatedBrush}"
                            IsVisible="{Binding !HasIcon}">
                      <TextBlock Text="{Binding Initial}" FontSize="14" Foreground="{DynamicResource TextStrongBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}"
                           Width="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                           Height="{Binding $parent[ItemsControl].((vm:PanelViewModel)DataContext).IconEdge}"
                           IsVisible="{Binding HasIcon}" />
                  </Panel>
                  <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextTrimming="CharacterEllipsis" MaxLines="2" />
                </StackPanel>
              </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
