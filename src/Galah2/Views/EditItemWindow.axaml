<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.EditItemWindow"
        x:DataType="vm:EditItemViewModel"
        Title="{Binding Title}"
        Width="460" Height="534"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </Window.Styles>

  <!-- Borderless surface: the same rounded RootBorder grammar as PanelWindow - the window
       itself is transparent, the surface, hairline and corners come from the Border. -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>
  <DockPanel Margin="20,16,20,16">
    <!-- Actions on the left, dismiss on the right: 1.x's button-order rule. -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
            Margin="0,14,0,0" Padding="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="取消" Command="{Binding CancelCommand}" />
        <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" BorderThickness="0"
                Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="68,*">
          <Border Grid.Column="0" Width="56" Height="56" CornerRadius="10" HorizontalAlignment="Left"
                  Background="{DynamicResource ElevatedBrush}"
                  BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Image Source="{Binding IconPreview}" Width="44" Height="44" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="label" Text="图标" Margin="0" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="选择图片…" Command="{Binding PickIconCommand}" FontSize="11.5" Padding="10,4" />
              <Button Content="从目标抓取" Command="{Binding FetchIconCommand}" FontSize="11.5" Padding="10,4" />
              <Button Content="重置" Command="{Binding ResetIconCommand}" FontSize="11.5" Padding="10,4" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <StackPanel>
          <TextBlock Classes="label" Text="名称" />
          <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="13" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="目标" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding TargetText, Mode=TwoWay}" FontSize="13" />
            <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseTargetCommand}"
                    FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding SuggestKind}">
          <Button Command="{Binding ApplySuggestedKindCommand}" FontSize="11.5"
                  HorizontalAlignment="Left" Content="看起来是别的类型，改用建议类型" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="启动参数（可选）" />
          <TextBox Text="{Binding Arguments, Mode=TwoWay}" FontSize="13" />
        </StackPanel>

        <StackPanel>
          <TextBlock Classes="label" Text="工作目录（可选）" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding WorkingDirectory, Mode=TwoWay}" FontSize="13" />
            <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseWorkdirCommand}"
                    FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>

        <CheckBox IsChecked="{Binding RunAsAdmin, Mode=TwoWay}" Content="以管理员身份运行"
                  FontSize="12.5" Margin="0,2,0,0" />

        <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasErrors}" />
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
    </DockPanel>
  </Border>
</Window>
