<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.MaintenanceWindow"
        x:DataType="vm:MaintenanceViewModel"
        Title="维护与迁移"
        Width="560" Height="574"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
      <Setter Property="Margin" Value="0,12,0,8" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.rowDetail">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>

  <!-- Borderless surface: the same rounded RootBorder grammar as PanelWindow. -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>
  <DockPanel Margin="18,14,18,14">
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
            Margin="0,12,0,0" Padding="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="重新扫描" Command="{Binding RescanCommand}" />
        <Button Content="关闭" Command="{Binding CloseCommand}" BorderThickness="0"
                Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" CornerRadius="8" Background="{DynamicResource ElevatedBrush}"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="12,10">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding Summary}" FontSize="12.5" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Padding="0,0,10,0">
      <StackPanel>
        <TextBlock Text="库维护" Classes="section" Margin="0,6,0,8" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="清理失效项" Command="{Binding RemoveInvalidCommand}"
                  IsEnabled="{Binding HasInvalid}" />
          <Button Content="移除重复项" Command="{Binding RemoveDuplicatesCommand}"
                  IsEnabled="{Binding HasDuplicates}" />
          <Button Content="按名称排序" Command="{Binding SortCommand}"
                  IsEnabled="{Binding HasUnsorted}" />
          <Button Content="重建图标缓存" Command="{Binding ClearCacheCommand}" />
        </StackPanel>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="失效项" />
        <TextBlock Text="没有失效项" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasInvalid}" />
        <ItemsControl ItemsSource="{Binding Invalid}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FindingViewModel">
              <StackPanel Margin="0,3,0,3">
                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                <TextBlock Classes="rowDetail" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="重复项" />
        <TextBlock Text="没有重复项" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasDuplicates}" />
        <ItemsControl ItemsSource="{Binding Duplicates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FindingViewModel">
              <StackPanel Margin="0,3,0,3">
                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                <TextBlock Classes="rowDetail" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="未排序的分类" />
        <TextBlock Text="所有分类都已按名称排序" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasUnsorted}" />
        <ItemsControl ItemsSource="{Binding UnsortedTabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="rowTitle" Text="{Binding}" Margin="0,2,0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="迁移" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="导出全部数据…" Command="{Binding ExportCommand}" />
          <Button Content="导入备份…" Command="{Binding ImportCommand}" />
        </StackPanel>
        <TextBlock Text="导出的 json 放在数据目录的 exports 子文件夹里。导入会把备份并入当前内容库，不会删除现有条目。"
                   FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
    </DockPanel>
  </Border>
</Window>
