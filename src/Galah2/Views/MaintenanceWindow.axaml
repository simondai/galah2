<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.MaintenanceWindow"
        x:DataType="vm:MaintenanceViewModel"
        Title="维护与迁移"
        Width="560" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.rowTitle">
      <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.rowDetail">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="18,14,18,14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="重新扫描" Command="{Binding RescanCommand}" />
      <Button Content="关闭" Command="{Binding CloseCommand}" Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Spacing="4">
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="库维护" Classes="section" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="清理失效项" Command="{Binding RemoveInvalidCommand}"
                  IsEnabled="{Binding HasInvalid}" />
          <Button Content="移除重复项" Command="{Binding RemoveDuplicatesCommand}"
                  IsEnabled="{Binding HasDuplicates}" />
          <Button Content="按名称排序" Command="{Binding SortCommand}"
                  IsEnabled="{Binding HasUnsorted}" />
          <Button Content="重建图标缓存" Command="{Binding ClearCacheCommand}" />
        </StackPanel>

        <TextBlock Classes="section" Text="失效项" />
        <TextBlock Text="没有失效项" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasInvalid}" />
        <ItemsControl ItemsSource="{Binding Invalid}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FindingViewModel">
              <StackPanel Margin="0,3,0,3">
                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                <TextBlock Classes="rowDetail" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="section" Text="重复项" />
        <TextBlock Text="没有重复项" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasDuplicates}" />
        <ItemsControl ItemsSource="{Binding Duplicates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FindingViewModel">
              <StackPanel Margin="0,3,0,3">
                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                <TextBlock Classes="rowDetail" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="section" Text="未排序的分类" />
        <TextBlock Text="所有分类都已按名称排序" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                   IsVisible="{Binding !HasUnsorted}" />
        <ItemsControl ItemsSource="{Binding UnsortedTabs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="rowTitle" Text="{Binding}" Margin="0,2,0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="section" Text="迁移" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="导出全部数据…" Command="{Binding ExportCommand}" />
          <Button Content="导入备份…" Command="{Binding ImportCommand}" />
        </StackPanel>
        <TextBlock Text="导出的 json 放在数据目录的 exports 子文件夹里。导入会把备份并入当前内容库，不会删除现有条目。"
                   FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
