<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Galah2.Views.PromptWindow"
        Width="360" Height="170"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1B1B1F">
  <DockPanel Margin="18,14,18,14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,14,0,0">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="确定" Click="Ok_Click" Background="#F5F5F7" Foreground="#1B1B1F" />
    </StackPanel>
    <TextBox x:Name="Input" FontSize="13" VerticalAlignment="Top" />
  </DockPanel>
</Window>
