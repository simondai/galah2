<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="440" Height="634"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">
  <!-- Borderless surface: the same rounded RootBorder grammar as PanelWindow - the window
       itself is transparent, the surface, hairline and corners come from the Border. -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource ElevatedBrush}"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>
  <!-- The combos bind ItemsSource to the view model's option arrays, so the label order and the
       index mapping live in one place and cannot drift apart. -->
  <DockPanel Margin="20,16,20,16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="关闭" Command="{Binding CloseCommand}" />
    </StackPanel>

    <!-- Horizontal scrolling disabled on purpose: with it enabled the content lays out at its
         unbounded desired width, so the star column had no constraint and the combo boxes ran
         under the vertical scrollbar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Classes="section" Text="全局快捷键" />
        <!-- Same width as the combos: an unconstrained TextBox stretches the full page and runs
             under the vertical scrollbar. -->
        <TextBox Text="{Binding HotkeyText, Mode=TwoWay}" FontSize="13"
                 HorizontalAlignment="Left" Width="196" />
        <TextBlock Classes="hint" Text="{Binding HotkeyHint}" Margin="0,6,0,0" />

        <TextBlock Classes="section" Text="外观" />
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="主题色" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="图标大小" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding IconSizeOptions}"
                      SelectedIndex="{Binding IconSizeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="分类名字号" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TabFontSizeOptions}"
                      SelectedIndex="{Binding TabFontSizeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="分类位置" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TabPositionOptions}"
                      SelectedIndex="{Binding TabPositionIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="面板材质" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MaterialOptions}"
                      SelectedIndex="{Binding MaterialIndex, Mode=TwoWay}" />
          </Grid>
        </StackPanel>

        <TextBlock Classes="section" Text="交互" />
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="点击方式" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ClickModeOptions}"
                      SelectedIndex="{Binding ClickModeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="面板位置" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding PlacementOptions}"
                      SelectedIndex="{Binding PlacementIndex, Mode=TwoWay}" />
          </Grid>
          <CheckBox IsChecked="{Binding HideOnLaunch, Mode=TwoWay}" Content="启动条目后收起面板" />
          <CheckBox IsChecked="{Binding HideOnBlur, Mode=TwoWay}" Content="面板失焦时自动收起" />
          <CheckBox IsChecked="{Binding ShowAddTile, Mode=TwoWay}"
                    Content="显示“添加”占位磁贴（分类末尾）" />
          <CheckBox IsChecked="{Binding WheelSwitchTab, Mode=TwoWay}" Content="滚轮切换分类" />
          <CheckBox IsChecked="{Binding NumberKeysSwitchTab, Mode=TwoWay}" Content="Ctrl+数字切换分类" />
        </StackPanel>

        <TextBlock Classes="section" Text="系统" />
        <StackPanel Spacing="8">
          <CheckBox IsChecked="{Binding AutoStart, Mode=TwoWay}" Content="开机自动启动" />
          <TextBlock Classes="hint" Text="{Binding AutoStartMessage}" />
          <Button Content="创建桌面快捷方式" Command="{Binding CreateShortcutCommand}"
                  HorizontalAlignment="Left" />
          <TextBlock Classes="hint" Text="{Binding ShortcutMessage}" />
          <StackPanel Margin="0,6,0,0">
            <TextBlock Classes="hint" Text="数据目录" />
            <SelectableTextBlock Text="{Binding DataFolder}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
    </DockPanel>
  </Border>
</Window>
