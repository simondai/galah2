<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="设置"
        Width="440" Height="634"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <!-- 设置页局部排版：拉开分组标题与设置项标签的视觉层级，统一标签垂直居中、下拉框等宽。 -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextStrongBrush}" />
      <Setter Property="Margin" Value="0,12,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
  </Window.Styles>
  <!-- Borderless surface: the same rounded RootBorder grammar as PanelWindow - the window
       itself is transparent, the surface, hairline and corners come from the Border. -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close (the system bar is gone). -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>
  <!-- The combos bind ItemsSource to the view model's option arrays, so the label order and the
       index mapping live in one place and cannot drift apart. -->
  <DockPanel Margin="20,16,20,16">
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
            Margin="0,12,0,0" Padding="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="关闭" Command="{Binding CloseCommand}" />
      </StackPanel>
    </Border>

    <!-- Horizontal scrolling disabled on purpose: with it enabled the content lays out at its
         unbounded desired width, so the star column had no constraint and the combo boxes ran
         under the vertical scrollbar. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,12,0">
      <StackPanel>
        <TextBlock Classes="section" Text="全局快捷键" Margin="0,0,0,8" />
        <StackPanel Spacing="10">
          <StackPanel>
            <Grid ColumnDefinitions="110,196">
              <TextBlock Grid.Column="0" Classes="label" Text="呼出热键" />
              <TextBox x:Name="HotkeyBox" Grid.Column="1" Text="{Binding HotkeyText, Mode=OneWay}" FontSize="13"
                       IsReadOnly="True" Cursor="Hand"
                       Watermark="点击后直接按下组合键"
                       ToolTip.Tip="点击框内后直接按下想要的新组合键（如 Alt+F1、Ctrl+Shift+G）"
                       HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding HotkeyHint}" Margin="110,6,0,0"
                       IsVisible="{Binding HotkeyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel>
            <Grid ColumnDefinitions="110,196">
              <TextBlock Grid.Column="0" Classes="label" Text="剪贴板热键" />
              <TextBox x:Name="ClipboardHotkeyBox" Grid.Column="1" Text="{Binding ClipboardHotkeyText, Mode=OneWay}" FontSize="13"
                       IsReadOnly="True" Cursor="Hand"
                       Watermark="点击后直接按下组合键"
                       ToolTip.Tip="点击框内后直接按下剪贴板历史呼出热键（默认 Alt+V）"
                       HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding ClipboardHotkeyHint}" Margin="110,6,0,0"
                       IsVisible="{Binding ClipboardHotkeyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <CheckBox IsChecked="{Binding ClipboardAutoPaste, Mode=TwoWay}"
                    Content="选中剪贴板历史后自动粘贴到原光标处" />
        </StackPanel>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="外观" />
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="主题色" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                      SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="图标大小" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding IconSizeOptions}"
                      SelectedIndex="{Binding IconSizeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="分类名字号" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TabFontSizeOptions}"
                      SelectedIndex="{Binding TabFontSizeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="主窗口布局" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding TabPositionOptions}"
                      SelectedIndex="{Binding TabPositionIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="面板材质" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MaterialOptions}"
                      SelectedIndex="{Binding MaterialIndex, Mode=TwoWay}" />
          </Grid>
        </StackPanel>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="交互" />
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="点击方式" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ClickModeOptions}"
                      SelectedIndex="{Binding ClickModeIndex, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnDefinitions="110,196">
            <TextBlock Grid.Column="0" Classes="label" Text="面板位置" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding PlacementOptions}"
                      SelectedIndex="{Binding PlacementIndex, Mode=TwoWay}" />
          </Grid>
          <StackPanel Spacing="6" Margin="0,2,0,0">
            <CheckBox IsChecked="{Binding HideOnLaunch, Mode=TwoWay}" Content="启动条目后收起面板" />
            <CheckBox IsChecked="{Binding HideOnBlur, Mode=TwoWay}" Content="面板失焦时自动收起" />
            <CheckBox IsChecked="{Binding ShowAddTile, Mode=TwoWay}"
                      Content="显示“添加”占位磁贴（分类末尾）" />
            <CheckBox IsChecked="{Binding WheelSwitchTab, Mode=TwoWay}" Content="滚轮切换分类" />
            <CheckBox IsChecked="{Binding NumberKeysSwitchTab, Mode=TwoWay}" Content="Ctrl+数字切换分类" />
          </StackPanel>
        </StackPanel>

        <Border Classes="divider" />
        <TextBlock Classes="section" Text="系统" />
        <StackPanel Spacing="8">
          <CheckBox IsChecked="{Binding AutoStart, Mode=TwoWay}" Content="开机自动启动" />
          <TextBlock Classes="hint" Text="{Binding AutoStartMessage}" Margin="26,-4,0,0"
                     IsVisible="{Binding AutoStartMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <CheckBox IsChecked="{Binding GpuAcceleration, Mode=TwoWay}" Content="开启 GPU 加速（重启后生效）" />
          <TextBlock Classes="hint" Text="{Binding GpuAccelerationMessage}" Margin="26,-4,0,0"
                     IsVisible="{Binding GpuAccelerationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Content="创建桌面快捷方式" Command="{Binding CreateShortcutCommand}"
                  HorizontalAlignment="Left" Margin="0,4,0,0" />
          <TextBlock Classes="hint" Text="{Binding ShortcutMessage}"
                     IsVisible="{Binding ShortcutMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Margin="0,6,0,0">
            <TextBlock Classes="hint" Text="数据目录" />
            <SelectableTextBlock Text="{Binding DataFolder}" FontSize="11"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <Border Classes="divider" />
        <Button Content="访问项目主页 · github.com/simondai/galah2"
                Click="OpenGitHub_Click"
                HorizontalAlignment="Center"
                Background="Transparent" BorderThickness="0"
                Padding="8,4" Margin="0,2,0,4"
                FontSize="11.5"
                Foreground="{DynamicResource AccentSurfaceBrush}"
                Cursor="Hand"
                ToolTip.Tip="https://github.com/simondai/galah2" />
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
    </DockPanel>
  </Border>
</Window>
