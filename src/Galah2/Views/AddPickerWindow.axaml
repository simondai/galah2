<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.AddPickerWindow"
        x:DataType="vm:AddPickerViewModel"
        Title="添加快捷方式"
        Width="520" Height="480"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DialogSurfaceBrush}">
  <DockPanel Margin="18,14,18,14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="取消" Command="{Binding CancelCommand}" />
      <Button Content="{Binding CommitLabel}" Command="{Binding CommitCommand}"
              IsEnabled="{Binding HasSelection}"
              Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
    </StackPanel>

    <!-- category chips -->
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SeedCategoryViewModel">
          <Button Content="{Binding Label}"
                  Classes="chip" Classes.active="{Binding IsActive}"
                  Command="{Binding $parent[ItemsControl].((vm:AddPickerViewModel)DataContext).SelectCategoryCommand}"
                  CommandParameter="{Binding}" Margin="0,0,6,6" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
      <TextBox Grid.Column="0" Text="{Binding Filter, Mode=TwoWay}" FontSize="12"
               Watermark="筛选…" />
      <Button Grid.Column="1" Content="全选/全不选" Command="{Binding ToggleAllCommand}"
              FontSize="11" Margin="6,0,0,0" />
      <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="11"
                 Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
    </Grid>

    <Panel>
      <TextBlock Text="正在枚举…" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding IsBusy}" />
      <TextBlock Text="这个分类没有可用项" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding HasNothing}" />

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Visible}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeedViewModel">
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,2,0,2">
                <!-- Icon, name, note: the same three-part row 1.x used, so candidates are
                     recognisable at a glance instead of being a wall of text. -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Panel Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{DynamicResource TilePlaceholderBrush}"
                            IsVisible="{Binding !HasIcon}">
                      <TextBlock Text="{Binding Initial}" FontSize="13"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="32" Height="32"
                           IsVisible="{Binding HasIcon}" />
                  </Panel>
                  <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" MaxWidth="330" />
                    <TextBlock Text="{Binding Note}" FontSize="10.5"
                               Foreground="{DynamicResource TextFaintBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="330" />
                  </StackPanel>
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
