<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Galah2.ViewModels"
        x:Class="Galah2.Views.AddPickerWindow"
        x:DataType="vm:AddPickerViewModel"
        Title="添加快捷方式"
        Width="684" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Window.Styles>
    <!-- 网格图标多选卡片：悬浮高亮、选中时显示强调色边框与淡色底 -->
    <Style Selector="Button.picker-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,8,6,6" />
      <Setter Property="Width" Value="116" />
      <Setter Property="Height" Value="96" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.picker-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.picker-card.checked">
      <Setter Property="Background" Value="{DynamicResource TilePlaceholderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>
    <Style Selector="Button.picker-card.checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TilePlaceholderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSurfaceBrush}" />
    </Style>
  </Window.Styles>

  <!-- Borderless surface: the same rounded RootBorder grammar as PanelWindow -->
  <Border x:Name="RootBorder" Background="{DynamicResource DialogSurfaceBrush}"
          CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
    <DockPanel>
      <!-- Custom title bar: title, drag, close -->
      <Border DockPanel.Dock="Top" Height="36" Background="{DynamicResource ElevatedBrush}"
              BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
              CornerRadius="10,10,0,0" PointerPressed="TitleBar_Drag">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13"
                     FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}"
                     Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <Button Grid.Column="1" Classes="chip" Content="✕" FontSize="13" Padding="8,0"
                  Margin="2,0,6,0" VerticalAlignment="Center" Click="TitleBar_Close" />
        </Grid>
      </Border>

      <DockPanel Margin="18,14,18,14">
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="0,10,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Content="{Binding CommitLabel}" Command="{Binding CommitCommand}"
                    IsEnabled="{Binding HasSelection}" BorderThickness="0"
                    Background="{DynamicResource AccentSurfaceBrush}" Foreground="{DynamicResource WindowBrush}" />
          </StackPanel>
        </Border>

        <!-- Category tabs -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}" Margin="0,0,0,10">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SeedCategoryViewModel">
              <Button Content="{Binding Label}"
                      Classes="chip" Classes.active="{Binding IsActive}"
                      Command="{Binding $parent[ItemsControl].((vm:AddPickerViewModel)DataContext).SelectCategoryCommand}"
                      CommandParameter="{Binding}" Margin="0,0,6,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Filter & bulk actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
          <TextBox Grid.Column="0" Text="{Binding Filter, Mode=TwoWay}" FontSize="12"
                   VerticalAlignment="Center" Watermark="筛选名称或路径…" />
          <Button Grid.Column="1" Content="全选/全不选" Command="{Binding ToggleAllCommand}"
                  FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="11.5"
                     Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
        </Grid>

        <!-- Grid icon multi-select view -->
        <Border CornerRadius="8" Background="{DynamicResource ElevatedBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="8,8">
          <Panel>
            <TextBlock Text="正在枚举…" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsBusy}" />
            <TextBlock Text="这个分类没有可用项" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding HasNothing}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
              <ItemsControl ItemsSource="{Binding Visible}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SeedViewModel">
                    <Button Classes="picker-card" Classes.checked="{Binding IsChecked}"
                            Command="{Binding ToggleCheckedCommand}"
                            Margin="3"
                            ToolTip.Tip="{Binding Note}">
                      <Grid RowDefinitions="Auto,*">
                        <!-- 右上角选中角标 -->
                        <Border Grid.Row="0" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-2,-2,0"
                                Background="{DynamicResource AccentSurfaceBrush}"
                                IsVisible="{Binding IsChecked}" ZIndex="2">
                          <TextBlock Text="✓" FontSize="11" FontWeight="Bold"
                                     Foreground="{DynamicResource WindowBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- 40x40 高清居中图标 -->
                        <Panel Grid.Row="0" Width="40" Height="40" HorizontalAlignment="Center" Margin="0,2,0,6">
                          <Border CornerRadius="8" Background="{DynamicResource TilePlaceholderBrush}"
                                  IsVisible="{Binding !HasIcon}">
                            <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Image Source="{Binding Icon}" Width="40" Height="40"
                                 RenderOptions.BitmapInterpolationMode="HighQuality"
                                 IsVisible="{Binding HasIcon}" />
                        </Panel>

                        <!-- 居中名称（最多两行省略） -->
                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </Border>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
