<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both the PE icon and the in-app avares://Galah2/Assets/galah.ico (tray) come from this
         one file: Assets/** is what the AvaloniaResource glob packages, app.ico at the project
         root was a byte-identical duplicate and is gone. -->
    <ApplicationIcon>Assets/galah.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Galah2</AssemblyName>
    <RootNamespace>Galah2</RootNamespace>
    <Version>2.9.0</Version>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.23" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="Styles/**" />
  </ItemGroup>

  <Import Project="aot.props" />
</Project>
