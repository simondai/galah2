<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Galah2/Galah2.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A real icon for the tray-menu section: TrayService builds a Bitmap from a stream, and a
         hand-rolled 1x1 PNG kept failing the decoder. This is the product's own app.ico. -->
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
